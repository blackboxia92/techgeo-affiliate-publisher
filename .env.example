# Public canonical origin. Use the final HTTPS domain with no trailing slash.
BASE_URL=https://example.com

# Generate with: python -m publisher key
INDEXNOW_KEY=

# Fixed by the project requirements. The code rejects any other value.
AMAZON_ASSOCIATE_TAG=blackboxia92-21

# Optional runtime paths.
CONTENT_DIR=content/pages
OUTPUT_DIR=dist
DATABASE_PATH=data/state.sqlite3

